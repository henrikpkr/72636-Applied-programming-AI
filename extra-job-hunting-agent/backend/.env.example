# Copy to backend/.env and fill in only what you need. Never commit the real .env.
# Every value is optional: with this file empty the app still runs, using the
# public sources (Arbeitnow, Bundesagentur, Greenhouse/Lever boards) and the
# rule-based CV extractor.

# Optional: Claude for better CV extraction and the source health monitor.
ANTHROPIC_API_KEY=
# HEALTH_CHECK_MODEL=claude-sonnet-5
# HEALTH_CHECK_INTERVAL_SECONDS=1800

# Optional: SQLite file (default: backend/data/jobhunter.sqlite3).
# JOBHUNTER_DB_PATH=

# Optional: Adzuna job search API, free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de

# Optional: credentialed portals. Leave blank unless you have approved access.
JOOBLE_ENDPOINT=
JOOBLE_API_KEY=
ARBEITSAGENTUR_ENDPOINT=
ARBEITSAGENTUR_TOKEN=
EURES_ENDPOINT=
EURES_TOKEN=

# Optional: extra company career boards per industry (JSON).
# Values are Greenhouse board tokens and Lever site names.
# GREENHOUSE_BOARDS_JSON={"technology": ["stripe", "airbnb"]}
# LEVER_SITES_JSON={"technology": ["example-company"]}
# GREENHOUSE_CATALOG_TOP_N=5
